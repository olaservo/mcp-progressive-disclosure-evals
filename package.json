{
  "name": "mcp-progressive-disclosure-evals",
  "version": "0.1.0",
  "private": true,
  "description": "The Cloudflare API MCP server's tools and skills served under each Groups/Skills positioning option from progressive-disclosure-wg#22",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "vendor:full": "node scripts/vendor.mjs --full",
    "select": "tsx scripts/select.ts",
    "describe": "tsx scripts/describe-groups.ts",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "claude plugin test mods/groups",
    "compare": "tsx scripts/compare.ts",
    "deploy:all": "node scripts/deploy-all.mjs",
    "trace:run": "tsx scripts/trace-run.ts",
    "trace:score": "tsx scripts/trace-score.ts",
    "trace:redact": "tsx scripts/trace-redact.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.9.0",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.53.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.2"
  }
}
